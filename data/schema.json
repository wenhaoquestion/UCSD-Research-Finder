{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/research-atlas.schema.json",
  "title": "Research Atlas Dataset",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "collectionPolicy",
    "professors",
    "labs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "datasetName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "collectionPolicy": {
      "type": "object",
      "required": [
        "publicPagesOnly",
        "recruitingClaimsRequireExplicitEvidence",
        "unknownMeansNoExplicitStatementCaptured"
      ],
      "properties": {
        "publicPagesOnly": {
          "type": "boolean"
        },
        "recruitingClaimsRequireExplicitEvidence": {
          "type": "boolean"
        },
        "unknownMeansNoExplicitStatementCaptured": {
          "type": "boolean"
        },
        "studentPrivacyBoundary": {
          "type": "string"
        }
      }
    },
    "professors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/professor"
      }
    },
    "labs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lab"
      }
    }
  },
  "$defs": {
    "urlOrMissing": {
      "type": "string",
      "pattern": "^(https?://|Not found$|Unknown$)"
    },
    "emailOrMissing": {
      "type": "string",
      "pattern": "^([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}|Not found|Unknown)$"
    },
    "recruitingStatus": {
      "type": "string",
      "enum": [
        "Recruiting",
        "Not recruiting",
        "Unknown"
      ]
    },
    "recruitingEvidence": {
      "type": "object",
      "required": [
        "text",
        "url"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "sourceUrls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https?://"
      }
    },
    "professor": {
      "type": "object",
      "required": [
        "id",
        "name",
        "institution",
        "department",
        "officialProfileUrl",
        "personalWebsiteUrl",
        "email",
        "researchAreas",
        "researchSummary",
        "googleScholarUrl",
        "labAffiliation",
        "recruitingStatus",
        "recruitingEvidence",
        "sourceUrls",
        "lastVerified"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "department": {
          "type": "string",
          "minLength": 1
        },
        "departments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mergedProfessorIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "officialProfileUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "personalWebsiteUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "email": {
          "$ref": "#/$defs/emailOrMissing"
        },
        "researchAreas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "researchSummary": {
          "type": "string",
          "minLength": 1
        },
        "googleScholarUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "externalProfiles": {
          "$ref": "#/$defs/externalProfiles"
        },
        "googleScholarSearchUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "linkedinSearchUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "possibleScholarSourceUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "academicProfile": {
          "$ref": "#/$defs/academicProfile"
        },
        "labAffiliation": {
          "type": "string"
        },
        "labAffiliationUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "recruitingStatus": {
          "$ref": "#/$defs/recruitingStatus"
        },
        "recruitingEvidence": {
          "$ref": "#/$defs/recruitingEvidence"
        },
        "sourceUrls": {
          "$ref": "#/$defs/sourceUrls"
        },
        "lastVerified": {
          "type": "string"
        }
      }
    },
    "academicProfile": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "openAlexAuthorId": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "openAlexUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "semanticScholarAuthorId": {
          "type": ["string", "null"]
        },
        "semanticScholarUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "matchedName": {
          "type": "string"
        },
        "matchConfidence": {
          "type": "number"
        },
        "worksCount": {
          "type": ["number", "string"]
        },
        "citationCount": {
          "type": ["number", "string"]
        },
        "hIndex": {
          "type": ["number", "string"]
        },
        "i10Index": {
          "type": ["number", "string"]
        },
        "recentPublications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "year": {
                "type": ["number", "string"]
              },
              "publicationDate": {
                "type": "string"
              },
              "citationCount": {
                "type": ["number", "string"]
              },
              "venue": {
                "type": "string"
              },
              "url": {
                "$ref": "#/$defs/urlOrMissing"
              },
              "doi": {
                "$ref": "#/$defs/urlOrMissing"
              },
              "openAlexUrl": {
                "$ref": "#/$defs/urlOrMissing"
              },
              "semanticScholarUrl": {
                "$ref": "#/$defs/urlOrMissing"
              },
              "journalImpactFactor": {
                "$ref": "#/$defs/journalImpactFactor"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "metricSources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "url": {
                "$ref": "#/$defs/urlOrMissing"
              },
              "matchConfidence": {
                "type": ["number", "string"]
              },
              "lastVerified": {
                "type": "string"
              }
            }
          }
        },
        "lastVerified": {
          "type": "string"
        }
      }
    },
    "externalProfiles": {
      "type": "object",
      "properties": {
        "googleScholar": {
          "$ref": "#/$defs/externalProfile"
        },
        "linkedin": {
          "$ref": "#/$defs/externalProfile"
        }
      }
    },
    "externalProfile": {
      "type": "object",
      "properties": {
        "profileUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "searchUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "candidate_search",
            "not_found",
            "blocked",
            "unavailable"
          ]
        },
        "sourceUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "lastChecked": {
          "type": "string"
        }
      }
    },
    "journalImpactFactor": {
      "type": "object",
      "properties": {
        "value": {
          "type": ["number", "string"]
        },
        "year": {
          "type": ["number", "string"]
        },
        "source": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "unavailable_open_data",
            "not_found",
            "unknown"
          ]
        }
      }
    },
    "lab": {
      "type": "object",
      "required": [
        "id",
        "labName",
        "institution",
        "department",
        "labWebsiteUrl",
        "principalInvestigator",
        "researchAreas",
        "description",
        "contactEmail",
        "recruitingStatus",
        "recruitingEvidence",
        "sourceUrls",
        "lastVerified"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "labName": {
          "type": "string",
          "minLength": 1
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "department": {
          "type": "string",
          "minLength": 1
        },
        "departments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mergedLabIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labWebsiteUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "principalInvestigator": {
          "type": "string"
        },
        "principalInvestigatorProfileUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "researchAreas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "contactEmail": {
          "$ref": "#/$defs/emailOrMissing"
        },
        "recruitingStatus": {
          "$ref": "#/$defs/recruitingStatus"
        },
        "recruitingEvidence": {
          "$ref": "#/$defs/recruitingEvidence"
        },
        "sourceUrls": {
          "$ref": "#/$defs/sourceUrls"
        },
        "lastVerified": {
          "type": "string"
        },
        "recordSubtype": {
          "type": "string",
          "enum": [
            "lab",
            "personal_research_site",
            "research_group",
            "research_area",
            "center",
            "program",
            "contact"
          ]
        },
        "entityType": {
          "type": "string"
        },
        "coverageStatus": {
          "type": "string",
          "enum": [
            "entity_verified",
            "overview_only",
            "needs_source_review"
          ]
        },
        "discoveryMethod": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "piCandidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overviewSourceUrl": {
          "$ref": "#/$defs/urlOrMissing"
        },
        "legacyKind": {
          "type": "string"
        }
      }
    }
  }
}
