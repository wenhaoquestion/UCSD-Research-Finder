  "proposedScienceChangesForParentOnly": {
    "status": "supported",
    "summaryZh": "根据标注2019年2月更新的研究页，Hermann实验室将结构化RNA作为药物靶点和自组装纳米材料开展研究。研究包括发现和验证RNA靶点、解析RNA与小分子配体的结构及设计RNA结合分子，以及构建RNA/RNA–DNA自组装纳米结构。页面列出分子生物学、生物化学、生物物理、合成有机化学、X射线晶体学及结构引导设计与增材、减材制造方法。",
    "researchQuestions": [
      "如何发现、验证RNA靶点，并用小分子配体调控或抑制其功能？",
      "如何利用RNA基序和DNA构件设计可自组装、可功能化的核酸纳米结构？"
    ],
    "topics": [
      "结构化RNA药物靶点",
      "RNA与小分子配体相互作用",
      "核酸自组装纳米材料",
      "RNA及RNA–DNA杂合纳米结构"
    ],
    "methods": [
      "分子生物学与生物化学方法",
      "生物物理方法",
      "合成有机化学",
      "X射线晶体学",
      "晶体结构引导的设计与筛选",
      "增材与减材制造"
    ],
