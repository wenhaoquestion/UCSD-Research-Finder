        ]
      },
      {
        "sourceId": "src-ba617541487c7584",
        "quote": "Our research focuses on utilizing experimental and computational approaches to elucidate the mechanisms by which cancers develop and in leveraging this knowledge for the development of better cancer prevention strategies and the improved targeting of existing cancer treatments.",
        "supports": [
          "research",
          "topics",
          "methods"
        ]
      },
      {
        "sourceId": "src-ba617541487c7584",
        "quote": "Throughout the past five years, our work has predominately focused on creating the concept of mutational signatures, on demonstrating the utility of mutational signatures in understanding human cancer, and on identifying mutational signatures in a plethora of diverse cancer types.",
        "supports": [
          "research",
          "topics",
          "methods"
        ]
      },
      {
        "sourceId": "src-9d02dfeba70a3fd7",
        "quote": "Our Lab has developed and maintains the SigProfiler suite of computational machine learning tools for analysis of next-generation generation cancer sequencing data.",
        "supports": [
          "methods",
          "topics"
        ]
      }
    ]
