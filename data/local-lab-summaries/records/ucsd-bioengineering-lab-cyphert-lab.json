      ]
    },
    {
      "sourceId": "src-f07e4c0e83df0fc5",
      "quote": "Our research focus is at the intersection of biomaterials and the microbiome.",
      "supports": [
        "research",
        "topics"
      ]
    },
    {
      "sourceId": "src-f07e4c0e83df0fc5",
      "quote": "We strive to use polymer chemistry and rational material design to engineer novel delivery systems to target microbiota communities.",
      "supports": [
        "research",
        "topics",
        "methods"
      ]
    },
    {
