{
  "labId": "ucsd-bioengineering-lab-cyphert-lab",
  "status": "supported",
  "summaryZh": "Cyphert 实验室的研究组结合聚合物化学和材料设计，开发可靶向微生物群落的响应性治疗载体。团队利用多组学、生物信息学和厌氧培养，评估新材料与分子对微生物群的治疗作用，涉及胃肠疾病、感染、癌症及细菌性阴道病。",
  "researchQuestions": [
    "所设计的材料如何与复杂微生物群落相互作用？"
  ],
  "topics": [
    "微生物治疗",
    "响应性递药载体",
    "微生物组",
    "疾病治疗"
  ],
  "methods": [
    "聚合物化学",
    "材料设计",
    "宏基因组",
    "代谢组学",
    "16S rRNA 测序",
    "生物信息学",
    "厌氧培养"
  ],
  "evidence": [
    {
      "sourceId": "src-21edcc67a4b2cb8c",
      "quote": "Her research group uses polymer chemistry and rational materials design principles to engineer responsive carriers for therapies to target microbiota communities.",
      "supports": [
        "research",
        "topics",
        "methods"
      ]
    },
    {
      "sourceId": "src-21edcc67a4b2cb8c",
      "quote": "They develop novel therapies to address diseases at a range of distal tissues that are associated with microbiota composition (GI disorders, infectious diseases, cancer, bacterial vaginosis).",
      "supports": [
        "research",
        "topics",
        "methods"
      ]
    },
    {
      "sourceId": "src-21edcc67a4b2cb8c",
      "quote": "They use cutting edge multi-omics (shotgun metagenomics, metabolomics, 16S rRNA sequencing) bioinformatic tools and anaerobic culturing to determine the therapeutic effect of novel materials and molecules on the microbiota.",
      "supports": [
        "research",
        "topics",
        "methods"
      ]
    },
    {
      "sourceId": "src-95510460d27fdf26",
      "quote": "Cyphert lab of microbial therapeutics",
      "supports": [
        "identity"
      ]
    },
