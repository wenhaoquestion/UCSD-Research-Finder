  "recommendation": {
    "status": "supported",
    "summaryZh": "Carlin 实验室研究宿主与病原体互作中的转录调控，关注病毒如何影响免疫防御、抗病毒转录网络，以及 Siglec 互作和遗传差异与感染易感性的关系。实验室开展全基因组方法及实验、计算工具开发，涉及 CRISPR、转录组学、表观基因组学、NGS 方案和生物信息学，并合作探索新兴感染病的抗微生物药物。",
    "researchQuestions": [
      "病毒如何通过转录、剪接和RNA稳定性调控影响宿主防御，这些作用是否具有细胞类型特异性？",
      "抗病毒转录网络如何受干扰素调节因子等炎症转录因子及细胞类型调控因子的共同影响？",
      "病原体与Siglec的互作以及人群Siglec遗传多样性如何影响发病与感染易感性？"
    ],
    "topics": [
      "宿主与病原体互作的转录调控",
      "病毒对免疫防御的调控",
      "抗病毒转录网络",
      "Siglec介导的识别与感染易感性",
      "新兴感染病的抗微生物药物研究"
    ],
    "methods": [
      "全基因组CRISPR方法",
      "转录组学",
      "表观基因组学",
      "NGS实验方案开发",
      "生物信息学分析",
      "实验和计算工具开发"
    ],
    "identity": {
      "status": "confirmed",
      "entityType": "lab",
      "reason": "实际完整正文具名Carlin Laboratory，并明确Dr. Carlin's lab及Research各节We的整体研究。"
    },
    "affiliation": {
      "status": "source_reported",
      "reason": "The Carlin Lab is located at the UCSD School of Medicine, in La Jolla, CA."
    },
    "evidence": [
      {
        "sourceId": "src-81dbfc5311a1ccab",
        "quote": "Dr. Carlin's lab investigates transcriptional mechanisms that determine the outcome of host-pathogen interactions.",
        "supports": [
          "identity",
          "research",
          "topics"
        ]
      },
      {
        "sourceId": "src-81dbfc5311a1ccab",
        "quote": "The Carlin Lab is located at the UCSD School of Medicine, in La Jolla, CA.",
        "supports": [
          "identity",
          "affiliation"
        ]
      },
      {
        "sourceId": "src-81dbfc5311a1ccab",
        "quote": "We are very interested in how viruses influence regulatory mechanisms to subvert cellular defenses. This includes effects that are gene-specific, transcription factor specific as well as global effects on transcription, splicing, and RNA stability. We aim to determine if specific interactions occur universally or in a cell-type specific manner and how they contribute to virulence.",
        "supports": [
          "research",
          "topics"
        ]
      },
      {
        "sourceId": "src-81dbfc5311a1ccab",
        "quote": "We study innate immune responses, leveraging genome-wide technologies and bioinformatics analysis to better understand transcriptional networks regulated by interferon regulatory factors (IRFs) and anti-viral pathways.",
        "supports": [
          "research",
          "topics",
          "methods"
        ]
      },
      {
        "sourceId": "src-81dbfc5311a1ccab",
        "quote": "We are interested in understanding how pathogen interactions with Siglecs modulate disease pathogenesis as well as how human genetic diversity of Siglecs alters susceptibility to microorganisms.",
        "supports": [
          "research",
          "topics"
        ]
      },
      {
        "sourceId": "src-81dbfc5311a1ccab",
        "quote": "Complementary, genome-wide methods, including CRISPR, transcriptomics and epigenomics, provide an unbiased and comprehensive way of expanding our understanding of host–viral interactions.",
        "supports": [
          "methods"
        ]
      },
      {
        "sourceId": "src-81dbfc5311a1ccab",
        "quote": "We are developing experimental and computational tools that improve sample processing and data integration to provide biologically meaningful conclusions.",
        "supports": [
          "methods"
        ]
      },
      {
        "sourceId": "src-81dbfc5311a1ccab",
        "quote": "We work closely with the Heinz, Benner and Glass Laboratories at UCSD to develop optimized or innovative NGS protocols to more specifically interrogate host-viral interactions in humans.",
        "supports": [
          "methods"
        ]
      },
      {
        "sourceId": "src-81dbfc5311a1ccab",
        "quote": "We collaborate with chemists, microbiologists and infectious disease physicians to develop and optimize new therapeutics for emerging infectious diseases.",
        "supports": [
          "research",
          "topics"
        ]
      },
      {
        "sourceId": "src-81dbfc5311a1ccab",
        "quote": "We study how the interplay between key inflammatory transcription factors, such as IRFs, NF-kB, and STATs, and cell-type specific master regulators (e.g. PU.1, C/EBP) induce specific target genes and antiviral transcriptional programs.",
        "supports": [
          "research",
          "topics"
        ]
      }
    ],
