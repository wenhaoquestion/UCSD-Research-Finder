    {
      "labId": "ucsd-astronomy-and-astrophysics-lab-space-weather-laboratory",
      "rawSha256": "ab7772d930fb3ca3a2424b829be5920196f369ff3ba2bd8a3b9f8312095ffca7",
      "rawReviewedAt": "2026-10-16T05:53:31+00:00",
      "status": "supported",
      "hydratePass": true,
      "currentEvidenceLiteralCount": 12,
      "newEvidence": [
        {
          "sourceId": "src-f8c7e9c911ee6b44",
          "quote": "Space Weather Laboratory UC San Diego researchers contribute to space, balloon, and ground-based instrumentation to study solar physics and space weather",
          "supports": [
            "identity",
            "affiliation",
            "research",
            "topics"
          ],
          "literal": true
        },
        {
          "sourceId": "src-f8c7e9c911ee6b44",
          "quote": "PI: Dr. Bernard Jackson",
          "supports": [
            "identity"
          ],
          "literal": true
        },
        {
          "sourceId": "src-04c9b7bf1a842574",
          "quote": "The results presented on this site represent the current status of an ongoing project in the Solar Group at A&A of a reconstruction of the global structure of the solar wind in near-real-time using interplanetary scintillation (IPS) observations received daily from the Institute for Space-Earth Environmental Research (ISEE), Nagoya University, Japan.",
          "supports": [
            "research",
            "topics"
          ],
          "literal": true
        },
        {
          "sourceId": "src-04c9b7bf1a842574",
          "quote": "Our goal is to forecast solar wind conditions in the near-Earth environment, and predict the arrival of solar wind structures at Earth.",
          "supports": [
            "research",
            "research_questions"
          ],
          "literal": true
        },
        {
          "sourceId": "src-04c9b7bf1a842574",
          "quote": "The reconstructions of the solar wind are based on a kinematic model of the solar wind.",
          "supports": [
            "methods"
          ],
          "literal": true
        },
        {
          "sourceId": "src-04c9b7bf1a842574",
          "quote": "An iterative least-squares algorithm is employed to obtain a 'best model' of the solar wind.",
          "supports": [
            "methods"
          ],
          "literal": true
        },
        {
          "sourceId": "src-04c9b7bf1a842574",
          "quote": "hence we call our technique 'heliospheric tomography'.",
          "supports": [
            "methods"
          ],
          "literal": true
        },
        {
          "sourceId": "src-04c9b7bf1a842574",
          "quote": "We use observations from spacecraft instruments to provide corraborative space weather data.",
          "supports": [
            "methods"
          ],
          "literal": true
        },
        {
          "sourceId": "src-04c9b7bf1a842574",
          "quote": "Our reconstruction of the solar wind aims at deriving the density and the outflow velocity in the inner heliosphere where the data coverage by the IPS observations is sufficiently high to obtain reliable results.",
          "supports": [
            "research",
            "topics"
          ],
          "literal": true
        },
        {
          "sourceId": "src-04c9b7bf1a842574",
          "quote": "the Advanced Composition Explorer ( ACE ) spacecraft provides in situ velocity and density observations at the L1 Lagrange point, which can be compared with the values from our kinematic 'best model'.",
          "supports": [
            "methods"
          ],
          "literal": true
        }
      ],
      "sourceScope": "Official named Space Weather Laboratory card links IPS within same card; lab solar physics/space weather separate from self-described Solar Group IPS-project research/methods. External ISEE instruments/data not lab ownership; undated ongoing/current/unique-system language not generalized to2026.",
      "scientificQA": "PASS",
      "ipsFinalFullSourcesActuallyRead": [
